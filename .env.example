# OAuth client (type: Desktop app) from Google Cloud Console.
# Copied into the bundle at build time by esbuild.config.mjs.
# Add http://127.0.0.1 to the Authorized redirect URIs of that client.
GOOGLE_CLIENT_ID=

# Optional. Only needed if Google returns "client_secret is missing".
# Google treats the secret of an installed app as non-confidential.
GOOGLE_CLIENT_SECRET=

# Open this plugin settings tab automatically after loading (development only).
DEV_OPEN_SETTINGS=false
